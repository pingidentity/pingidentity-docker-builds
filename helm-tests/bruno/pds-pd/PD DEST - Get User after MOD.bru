meta {
  name: PD DEST - Get User after MOD
  type: http
  seq: 7
}

get {
  url: https://{{K8S_STATEFUL_SET_SERVICE_NAME}}:{{pd_port_https}}/directory/v1/uid={{regular_user}},ou=people,ou=destination,{{base_dn}}
  body: none
  auth: inherit
}

script:pre-request {
  await bru.sleep(2000);
}

script:post-response {
  test('Status code is ' + res.getStatus(), function(){
      expect(res.getStatus()).to.equal(200);
  });
  var jsonData = res.getBody();
  test('description = ' + jsonData.description[0], function(){
      expect(jsonData.description[0]).to.equal(bru.getCollectionVar("regular_user"));
  });
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
