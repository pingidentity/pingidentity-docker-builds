meta {
  name: PD DEST - Get User after ADD
  type: http
  seq: 5
}

get {
  url: https://{{K8S_STATEFUL_SET_SERVICE_NAME}}:{{pd_port_https}}/directory/v1/uid={{regular_user}},ou=people,ou=destination,{{base_dn}}
  body: none
  auth: inherit
}

script:pre-request {
  await bru.sleep(2000);
  
}

script:post-response {
  test('Status code is ' + res.getStatus(), function(){
      expect(res.getStatus()).to.equal(200);
  });
  var jsonData = res.getBody();
  test('Added ' + jsonData['_dn'], function(){
      expect(jsonData['_dn']).to.equal("uid=" + bru.getCollectionVar("regular_user") + ",ou=people,ou=destination," + bru.getCollectionVar("base_dn"));
  });
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
