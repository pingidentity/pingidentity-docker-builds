meta {
  name: PD REST API check user created thru proxy
  type: http
  seq: 39
}

get {
  url: https://{{PD_ENGINE_PRIVATE_HOSTNAME}}-cluster:{{pd_port_https}}/directory/v1/uid=proxy.user.0,ou=People,{{_base_dn}}
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

script:post-response {
  test("response is ok", function(){
      expect(res.getStatus()).to.equal(200);
  });
  
  test("response is not empty", function(){
      expect(res.getBody() !== undefined && res.getBody() !== '').to.be.true;
  });
  
  test("response is JSON", function(){
      // (postman no-op retained: pm.response.to.be.json)
  });
  
  var jsonData = res.getBody();
  
  test("description is directory", function(){
      expect(jsonData["description"][0].toLowerCase()).to.be.equal("created thru proxy");
  });
  
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
