meta {
  name: PDP REST API get user before becoming member of group
  type: http
  seq: 33
}

get {
  url: https://{{PDP_ENGINE_PRIVATE_HOSTNAME}}:{{PDP_ENGINE_PRIVATE_PORT_HTTPS}}/directory/v1/uid=postman.user.0,ou=People,{{_base_dn}}
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

script:post-response {
  test("response is ok", function(){
      expect(res.getStatus()).to.equal(200);
  });
  
  test("response is not empty", function(){
      expect(res.getBody() !== undefined && res.getBody() !== '').to.be.true;
  });
  
  test("response is JSON", function(){
      // (postman no-op retained: pm.response.to.be.json)
  });
  
  var jsonData = res.getBody();
  
  test("description is proxy", function(){
      expect(jsonData["description"][0].toLowerCase()).to.be.equal("hello from proxy");
  });
  
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
