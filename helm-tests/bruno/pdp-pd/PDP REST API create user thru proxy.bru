meta {
  name: PDP REST API create user thru proxy
  type: http
  seq: 38
}

post {
  url: https://{{PDP_ENGINE_PRIVATE_HOSTNAME}}:{{PDP_ENGINE_PRIVATE_PORT_HTTPS}}/directory/v1
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
      "mail": [
          "proxy.user.0@example.com"
  	],
      "sn": [
          "proxy"
      ],
      "cn": [
          "Proxy User.0"
      ],
      "givenName": [
          "proxy.user.0"
      ],
      "userPassword": [
      	"{{regular_pwd}}"
      	],
      "pf-connected-identity": [
          "auth-source=pf-local-identity:user-id=proxy.user.0"
      ],
      "uid": [
          "{{regular_user}}"
      ],
      "objectClass": [
          "top",
          "person",
          "organizationalPerson",
          "inetOrgPerson",
          "pf-connected-identities"
      ],
      "description": [
      	"created thru proxy"
  	],
      "_dn": "uid=proxy.user.0,ou=people,{{_base_dn}}"
  }
}

script:post-response {
  test("response is ok", function(){
      // 201 means means the creation worked
      // 409 means the entry already existed
      expect([201,409]).to.include(res.getStatus());
  });
  
  test("response is not empty", function(){
      expect(res.getBody() !== undefined && res.getBody() !== '').to.be.true;
  });
  
  test("response is JSON", function(){
      // (postman no-op retained: pm.response.to.be.json)
  });
  
  var jsonData = res.getBody();
  
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
