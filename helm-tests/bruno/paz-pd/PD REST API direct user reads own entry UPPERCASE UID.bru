meta {
  name: PD REST API direct user reads own entry UPPERCASE UID
  type: http
  seq: 7
}

get {
  url: https://{{K8S_STATEFUL_SET_SERVICE_NAME}}:{{pd_port_https}}/directory/v1/UID=user.1,ou=people,{{_base_dn}}
  body: json
  auth: bearer
}

params:query {
  ~: 
}

headers {
  ~Authorization: Bearer {"active":true,"sub":"useasdfadsfr.0","scope":"accounts"}
}

auth:bearer {
  token: { "active":true,"sub" : "user.1", "clientId":"client1","scope":"ds" }
}

script:post-response {
  test("User Mail retrieved", function () {
      expect(res.getStatus()).to.be.within(200, 299);
  });
  
  test("response is not empty", function(){
      expect(res.getBody() !== undefined && res.getBody() !== '').to.be.true;
  });
  
  test("response is JSON", function(){
      // (postman no-op retained: pm.response.to.be.json)
  });
  
  var jsonData = res.getBody();
  test("json data is not empty",function(){
      expect(jsonData).to.not.be.empty;
  });
  
  test("mail is present",function(){
      expect(jsonData["mail"]).to.exist;
  });
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
