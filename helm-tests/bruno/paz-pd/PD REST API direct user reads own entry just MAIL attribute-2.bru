meta {
  name: PD REST API direct user reads own entry just MAIL attribute
  type: http
  seq: 5
}

get {
  url: https://{{K8S_STATEFUL_SET_SERVICE_NAME}}:{{pd_port_https}}/directory/v1/uid=user.1,ou=people,{{_base_dn}}?includeAttributes=MAIL
  body: json
  auth: bearer
}

params:query {
  includeAttributes: MAIL
  ~: 
}

headers {
  ~Authorization: Bearer {"active":true,"sub":"useasdfadsfr.0","scope":"accounts"}
}

auth:bearer {
  token: { "active":true,"sub" : "user.1", "clientId":"client1","scope":"ds" }
}

script:post-response {
  test("User Mail retrieved", function () {
      expect(res.getStatus()).to.not.be.within(200, 299);
  });
  test("response is invalid", function(){
      expect(res.getStatus()).to.equal(400);
  });
  test("response is not empty", function(){
      expect(res.getBody() !== undefined && res.getBody() !== '').to.be.true;
  });
  
  test("response is JSON", function(){
      // (postman no-op retained: pm.response.to.be.json)
  });
  
  var jsonData = res.getBody();
  test("json data is not empty",function(){
      expect(jsonData).to.not.be.empty;
  });
  
  test("mail is not present",function(){
      expect(jsonData["mail"]).to.not.exist;
  });
  
  test("uid is not present",function(){
      expect(jsonData["uid"]).to.not.exist;
  });
  
  test("code is present",function(){
      expect(jsonData["code"]).to.exist;
  });
  
  test("code is INVALID_REQUEST",function(){
      expect(jsonData["code"]).to.be.equal("INVALID_REQUEST");
  });
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
