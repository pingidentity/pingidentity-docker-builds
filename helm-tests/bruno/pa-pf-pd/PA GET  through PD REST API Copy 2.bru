meta {
  name: PA GET  through PD REST API Copy 2
  type: http
  seq: 29
}

get {
  url: https://{{PA_ENGINE_PRIVATE_HOSTNAME}}:{{PA_ENGINE_PRIVATE_PORT_HTTPS}}/directory/v1/uid=postman.user.0,ou=People,{{_base_dn}}
  body: none
  auth: bearer
}

headers {
  X-Ping-Build-Run-Id: {{_runId}}
}

auth:bearer {
  token: {{accessToken}}
}

script:pre-request {
  var _runId = Math.floor(Math.random()*100000);
  bru.setVar("_runId",_runId);
}

script:post-response {
      test("response is ok", function(){
          expect(res.getStatus()).to.equal(200);
      });
      
      test("response is not empty", function(){
          expect(res.getBody() !== undefined && res.getBody() !== '').to.be.true;
      });
  
      test("response is JSON", function(){
          // (postman no-op retained: pm.response.to.be.json)
      });
  
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
