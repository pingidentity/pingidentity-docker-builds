meta {
  name: PA CHECK PingAccess engine honors requests
  type: http
  seq: 4
}

get {
  url: https://{{PA_ENGINE_PRIVATE_HOSTNAME}}:{{PA_ENGINE_PRIVATE_PORT_HTTPS}}/pa/heartbeat.ping
  body: none
  auth: inherit
}

script:pre-request {
  var _host = bru.getEnvVar("PA_ENGINE_PRIVATE_HOSTNAME");
  var _port = bru.getEnvVar("PA_ENGINE_PRIVATE_PORT_HTTPS");
  console.log("Attempting connection to https://"+_host+":" +_port+ " ...");
}

script:post-response {
  test("response is ok", function(){
      expect(res.getStatus()).to.equal(200);
  });
  
  test("response is not empty", function(){
      expect(res.getBody() !== undefined && res.getBody() !== '').to.be.true;
  });
  
  test("response is JSON", function(){
      // (postman no-op retained: pm.response.to.be.json)
  });
  
  var jsonData = res.getBody();
  
  test("cpu.load key is present", function () {
      expect(jsonData.hasOwnProperty("cpu.load")).to.be.true;
  });
  
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
