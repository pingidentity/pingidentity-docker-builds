meta {
  name: PD Config API get all Back-ends
  type: http
  seq: 12
}

get {
  url: https://{{K8S_STATEFUL_SET_SERVICE_NAME}}:{{pd_port_https}}/config/backends
  body: none
  auth: inherit
}

script:post-response {
  test("response is ok", function(){
      expect(res.getStatus()).to.equal(200);
  });
  
  test("response is not empty", function(){
      expect(res.getBody() !== undefined && res.getBody() !== '').to.be.true;
  });
  
  test("response is JSON", function(){
      // (postman no-op retained: pm.response.to.be.json)
  });
  
  var jsonData = res.getBody();
  
  test("Resources  key is present", function(){
      expect(jsonData["Resources"]).to.exist;
      console.log("Back-ends reported in configuration:");
      jsonData["Resources"].forEach(function(backend){console.log("  - "+backend["backendID"]);});
  });
  
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
