meta {
  name: PD REST API delete user
  type: http
  seq: 14
}

delete {
  url: https://{{PD_ENGINE_PRIVATE_HOSTNAME}}-0.{{PD_ENGINE_PRIVATE_HOSTNAME}}-cluster:{{pd_port_https}}/directory/v1/uid=postman.user.0,ou=people,{{_base_dn}}
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

script:post-response {
  test("response is ok", function(){
      expect(res.getStatus()).to.equal(204);
  });
  
  test("response is empty", function(){
      expect(res.getBody()).to.not.equal();
  });
  
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
