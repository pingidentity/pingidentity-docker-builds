meta {
  name: PingDataConsole login page
  type: http
  seq: 3
}

get {
  url: https://{{PD_CONSOLE_PRIVATE_HOSTNAME}}:{{PD_CONSOLE_PRIVATE_PORT_HTTPS}}/console/login
  body: none
  auth: inherit
}

script:post-response {
  test("PingDataConsole login page returns 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test("PingDataConsole login page contains product title", function () {
      expect(res.getBody()).to.include("PingData Administrative Console");
  });
  
  bru.runner.setNextRequest(null);
  
}

settings {
  encodeUrl: true
  followRedirects: false
  forwardAuthorizationHeader: false
}
