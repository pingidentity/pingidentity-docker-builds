meta {
  name: PD REST API get user after becoming member of group
  type: http
  seq: 25
}

get {
  url: https://{{K8S_STATEFUL_SET_SERVICE_NAME}}:{{PD_ENGINE_PUBLIC_PORT_HTTPS}}/directory/v1/uid=postman.user.0,ou=People,{{_base_dn}}
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

script:post-response {
  test("response is ok", function(){
      expect(res.getStatus()).to.equal(200);
  });
  
  test("response is not empty", function(){
      expect(res.getBody() !== undefined && res.getBody() !== '').to.be.true;
  });
  
  test("response is JSON", function(){
      // (postman no-op retained: pm.response.to.be.json)
  });
  
  var jsonData = res.getBody();
  
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
