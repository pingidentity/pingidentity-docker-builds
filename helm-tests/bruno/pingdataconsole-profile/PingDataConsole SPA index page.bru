meta {
  name: PingDataConsole SPA index page
  type: http
  seq: 4
}

get {
  url: https://{{PD_CONSOLE_PRIVATE_HOSTNAME}}:{{PD_CONSOLE_PRIVATE_PORT_HTTPS}}/console/index.html
  body: none
  auth: inherit
}

script:post-response {
  test("PingDataConsole SPA index page returns 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test("PingDataConsole SPA index page contains root element", function () {
      expect(res.getBody()).to.include('<div id="root"');
  });
  
  bru.runner.setNextRequest(null);
  
}

settings {
  encodeUrl: true
  followRedirects: false
  forwardAuthorizationHeader: false
}
