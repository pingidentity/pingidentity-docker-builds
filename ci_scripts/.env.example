# Local paths for the portal docs sync (PDI-2517).
#
# Copy to ci_scripts/.env (gitignored) and edit. Both sync_portal_docs.sh
# and publish_portal_docs.sh source this file; a positional PORTAL_REPO
# argument still wins over what is set here.

# Path to a local clone of docs-devops-getting-started
DOCS_PORTAL_REPO=/path/to/docs-devops-getting-started

# Optional: branch name publish_portal_docs.sh creates in the portal repo
# (default docs-sync-docker-images)
#DOCS_SYNC_BRANCH=docs-sync-docker-images
